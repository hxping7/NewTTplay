; 鲸鱼娘桌宠配置模板
; 复制为 AddIn/whale.ini 后按需修改。运行时程序会写入 pos/affinity/last_day/songN。

[pet]
pos=1558,760
topmost=1
; 好感度 0-100，摸头/投喂会增加，影响她的心情与台词
affinity=50
; 上次见面日期序号（程序自动维护，勿手改）
last_day=0

[music]
; v16 音乐人格 —— 她是一个有喜好的挑剔听众
;
; 喜好清单：逗号分隔，歌手名/流派名。子串匹配（"周杰伦"也匹配"周杰伦的歌"）。
; 初始值由曲库统计推断：梁静茹 231 首、光良 177、周杰伦 57、林俊杰 41。
; 曲风来自音频文件的 ID3/FLAC 标签（如 Rock/Blues/Funk/Jazz），不是猜歌名。
;
; 喜欢的歌手（+45 分，足以单独触发强烈反应）
likes=梁静茹,光良,周杰伦,林俊杰,王菲,Pink Floyd,五月天,陈奕迅
; 讨厌的歌手（-50 分，听到会皱眉）
dislikes=
; 喜欢的曲风（+20 分）
like_genres=Rock,Blues,Funk,Jazz,Classical,Acoustic
; 讨厌的曲风（-30 分）
dislike_genres=
; 音乐人格使用的好感度（与 [pet] 独立，程序会同步）
affinity=50
;
; songN 是歌曲记忆（程序自动写入，勿手改）：
;   歌手|歌名|播放次数|被摸次数|上次日期|亲密度
